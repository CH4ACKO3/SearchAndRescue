<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- More Injuries' native blood-volume jobs remain in Doctor as a fallback. Moving them
       outright to Nursing lets RimWorld choose Doctor work first whenever a pawn has both
       work types at the same player priority. Add parallel Nursing givers instead. Search and
       Rescue's marked-care graph independently prefers nurses for every fixed-effect round. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Nurse Job</li>
    </mods>
    <match Class="PatchOperationFindMod">
      <mods>
        <li>More Injuries</li>
        <li>More Injuries (Continued)</li>
      </mods>
      <match Class="PatchOperationSequence">
        <success>Always</success>
        <operations>
          <li Class="PatchOperationAdd">
            <xpath>/Defs</xpath>
            <value>
              <WorkGiverDef>
                <defName>SAR_NurseUseBloodBag</defName>
                <label>perform a blood transfusion to stabilize patients with severe blood loss</label>
                <giverClass>MoreInjuries.AI.WorkGivers.WorkGiver_UseBloodBag</giverClass>
                <workType>Nursing</workType>
                <emergency>true</emergency>
                <verb>perform blood transfusion on</verb>
                <gerund>performing blood transfusion on</gerund>
                <requiredCapacities><li>Manipulation</li></requiredCapacities>
                <priorityInType>130</priorityInType>
                <prioritizeSustains>true</prioritizeSustains>
              </WorkGiverDef>
              <WorkGiverDef>
                <defName>SAR_NurseUseSalineBag</defName>
                <label>perform a saline IV infusion to stabilize patients with severe blood loss</label>
                <giverClass>MoreInjuries.AI.WorkGivers.WorkGiver_UseSalineBag</giverClass>
                <workType>Nursing</workType>
                <emergency>true</emergency>
                <verb>perform saline IV infusion on</verb>
                <gerund>performing saline IV infusion on</gerund>
                <requiredCapacities><li>Manipulation</li></requiredCapacities>
                <priorityInType>129</priorityInType>
                <prioritizeSustains>true</prioritizeSustains>
              </WorkGiverDef>
            </value>
          </li>
        </operations>
      </match>
    </match>
  </Operation>
</Patch>
