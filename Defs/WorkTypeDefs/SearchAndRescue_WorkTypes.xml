<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <WorkTypeDef>
    <defName>SAR_FieldRescue</defName>
    <labelShort>field rescue</labelShort>
    <pawnLabel>Field responder</pawnLabel>
    <gerundLabel>field rescue</gerundLabel>
    <description>Coordinate battlefield triage, stabilization, medical supply, capture and evacuation. Hospital tending and surgery remain Doctor work.</description>
    <verb>Rescue</verb>
    <!-- Between Patient (1350) and Doctor (1300): at the same configured priority,
         battlefield emergencies are considered before ordinary hospital care. -->
    <naturalPriority>1325</naturalPriority>
    <requireCapableColonist>true</requireCapableColonist>
    <relevantSkills>
      <li>Medicine</li>
    </relevantSkills>
    <!-- Individual lanes enforce Caring, Hauling, Warden and Nursing authority.
         The parent work type deliberately remains available to non-doctor carriers. -->
    <workTags>
      <li>Commoner</li>
      <li>AllWork</li>
    </workTags>
  </WorkTypeDef>
</Defs>
